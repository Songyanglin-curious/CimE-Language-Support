{
  "comments": {
    "lineComment": "//",
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [],
  "autoClosingPairs": [
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["'", "'"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?\\d+(\\.\\d+)?)|([\\p{L}_][\\p{L}\\p{N}_:.-]*)",
  "folding": {
    "markers": {
      "start": "^\\s*(?:<(?!(?:/|!|@|#))[^>]*[^/]>|<@#?>)\\s*$",
      "end": "^\\s*(?:</[^>]+>|</@#?>)\\s*$"
    }
  }
}
