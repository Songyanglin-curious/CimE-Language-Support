{
    "name": "cime-file-tools",
    "displayName": "CIME 文件工具",
    "description": "为 CIM/E 文件提供语法着色、结构折叠和 Sticky Scroll 表头支持。",
    "version": "0.3.0",
    "publisher": "syldev",
    "license": "MIT",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Songyanglin-curious/CimE-Language-Support.git"
    },
    "bugs": {
        "url": "https://github.com/Songyanglin-curious/CimE-Language-Support/issues"
    },
    "homepage": "https://github.com/Songyanglin-curious/CimE-Language-Support#readme",
    "keywords": [
        "CIM/E",
        "CIME",
        "CIM",
        "电力系统",
        "GB/T 30149",
        "syntax highlighting",
        "folding",
        "sticky scroll"
    ],
    "main": "./src/extension.js",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "[cime]": {
                "editor.renderWhitespace": "all",
                "editor.tabSize": 4,
                "editor.detectIndentation": false
            }
        },
        "languages": [
            {
                "id": "cime",
                "aliases": [
                    "CIM/E",
                    "cime"
                ],
                "extensions": [
                    ".cime",
                    ".CIME"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "cime",
                "scopeName": "source.cime",
                "path": "./syntaxes/cime.tmLanguage.json"
            }
        ]
    }
}
